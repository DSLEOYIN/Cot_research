# Runtime mode: mock is the default and does not require API keys or database access.
APP_MODE=mock
MOCK_ENABLED=true

# Model provider settings for APP_MODE=real.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com/chat/completions
MODEL_NAME=deepseek-chat
MODEL_TEMPERATURE=0.2
MODEL_MAX_TOKENS=4096

# Database settings for APP_MODE=real.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CHARSET=utf8mb4
DB_ALLOWED_TABLES=v_dm_sal_wolesale_terminal_dly,v_dm_sal_stock_dly,v_dm_sal_sc_order_dly,v_dm_sal_scheduling_dly
SQL_MAX_ROWS=500
DB_CONNECT_TIMEOUT=5
DB_READ_TIMEOUT=30
DB_WRITE_TIMEOUT=30
