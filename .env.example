# Runtime mode: mock is the default and does not require API keys or database access.
APP_MODE=mock
MOCK_ENABLED=true

# Model provider settings for APP_MODE=real.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com/chat/completions
MODEL_NAME=deepseek-chat
MODEL_TEMPERATURE=0.2
MODEL_MAX_TOKENS=4096

# Database settings for APP_MODE=real.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CHARSET=utf8mb4
DB_ALLOWED_TABLES=v_dm_sal_wolesale_terminal_dly,v_dm_sal_stock_dly,v_dm_sal_sc_order_dly,v_dm_sal_scheduling_dly
SQL_MAX_ROWS=500
DB_CONNECT_TIMEOUT=5
DB_READ_TIMEOUT=30
DB_WRITE_TIMEOUT=30

# SSH Tunnel configuration (if database/Dify are behind an SSH bastion)
SSH_ENABLED=true
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_PASSWORD=

# Dify Knowledge Base API settings
DIFY_ENABLED=false
DIFY_BASE_URL=http://your-dify-host:9879
DIFY_API_KEY=
DIFY_DATASET_ID=

# Web / Internet MCP settings, reserved for an optional web_search MCP
WEB_MCP_ENABLED=false
WEB_MCP_PROVIDER=tavily
WEB_MCP_BASE_URL=https://api.tavily.com
WEB_MCP_API_KEY=
WEB_MCP_SEARCH_ENDPOINT=/search
WEB_MCP_TIMEOUT=15
WEB_MCP_TOP_K=5
WEB_MCP_PROXY=
